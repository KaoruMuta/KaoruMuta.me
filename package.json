{
  "name": "mysite",
  "version": "2.2.3",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
