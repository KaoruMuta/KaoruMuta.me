    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/gtag.js": "0.0.20",
    "@types/marked": "6.0.0",
    "@types/prismjs": "1.26.6",
    "ansi-regex": "6.2.2",
    "babel-plugin-prismjs": "2.1.0",
    "gray-matter": "4.0.3",
    "marked": "18.0.7",
    "next": "16.2.11",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "react-share": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "next-sitemap": "4.2.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "postcss": "8.5.23",
